# Directorio de datos que lee FastAPI (data/processed o data/fixtures)
MCHANAQ_DATA_DIR=data/fixtures
# Poner en 1 en desarrollo/fixtures para desactivar Cache-Control
MCHANAQ_NO_CACHE=1
# Orígenes CORS permitidos separados por coma (o * en hackathon)
MCHANAQ_CORS_ORIGINS=http://localhost:5173
# Expresión regular opcional de CORS (ej. vistas previas *.pages.dev en Cloudflare Pages)
# MCHANAQ_CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*tu-proyecto\.pages\.dev$
# Base de la API que consume el frontend al compilar (Vite)
VITE_API_BASE=http://localhost:8000/api/v1
